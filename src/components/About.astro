---
import Section from './Section.astro';
import type { Profile } from '../types/profile';

interface Props {
  about: Profile['about'];
}
const { about } = Astro.props;
---

<Section id="about" index="01" title="About" kicker="whoami">
  <p class="reveal max-w-3xl text-xl leading-relaxed text-fg/90 md:text-2xl md:leading-relaxed">
    {about}
  </p>
</Section>
