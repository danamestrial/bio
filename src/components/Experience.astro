---
import Section from './Section.astro';
import type { Profile } from '../types/profile';

interface Props {
  experience: Profile['experience'];
}
const { experience } = Astro.props;

// Compact year span per workplace, parsed from the human period strings so it
// stays correct without a separate machine end-date field.
function span(job: Profile['experience'][number]): string {
  const years = job.roles.flatMap((r) => [...r.period.matchAll(/20\d{2}/g)].map((m) => Number(m[0])));
  const min = Math.min(...years);
  const current = job.roles.some((r) => /present/i.test(r.period));
  if (current) return `${min} — Now`;
  const max = Math.max(...years);
  return min === max ? `${min}` : `${min} — ${max}`;
}
---

<Section id="experience" index="02" title="Experience" kicker="career log">
  <ol class="border-t border-border">
    {
      experience.map((job, i) => (
        <li
          class="reveal grid grid-cols-1 gap-x-8 gap-y-3 border-b border-border py-8 md:grid-cols-[8rem_1fr]"
          style={`--reveal-delay: ${i * 60}ms`}
        >
          <div class="md:pt-1">
            <p class="font-mono text-sm font-medium tabular-nums text-accent">{span(job)}</p>
            <p class="mt-1 font-mono text-xs text-faint">{job.location}</p>
          </div>

          <article class="min-w-0">
            <h3 class="font-display text-xl font-semibold">{job.company}</h3>

            <ul class="mt-2 space-y-1">
              {job.roles.map((role) => (
                <li class="flex flex-wrap items-baseline gap-x-3">
                  <span class="text-fg/90">{role.title}</span>
                  <time class="font-mono text-xs text-muted" datetime={role.start}>
                    {role.period}
                  </time>
                </li>
              ))}
            </ul>

            <p class="mt-4 max-w-2xl leading-relaxed text-muted">{job.summary}</p>

            <ul class="mt-4 flex flex-wrap gap-2" aria-label="Skills used">
              {job.skills.map((skill) => (
                <li class="rounded border border-border bg-surface px-2.5 py-1 font-mono text-xs text-muted">
                  {skill}
                </li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>
</Section>
