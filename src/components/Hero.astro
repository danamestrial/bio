---
import type { Profile } from '../types/profile';

interface Props {
  name: Profile['name'];
  headline: Profile['headline'];
  tagline: Profile['tagline'];
  location: Profile['location'];
  links: Profile['links'];
  resumeUrl: Profile['resumeUrl'];
  /** compact figures for the hero footer strip */
  stats: { value: string; label: string }[];
}
const { name, headline, tagline, location, links, resumeUrl, stats } = Astro.props;
const primary = links.filter(
  (l) => l.kind === 'email' || l.kind === 'github' || l.kind === 'linkedin'
);
---

<header class="relative -mt-20 w-full overflow-hidden pt-20">
  <!-- full-bleed dotted grid, soft-masked at the edges -->
  <div aria-hidden="true" class="hero-grid pointer-events-none absolute inset-0"></div>
  <!-- slow-drifting accent blob -->
  <div
    aria-hidden="true"
    class="hero-blob pointer-events-none absolute left-1/3 top-1/3 h-[30rem] w-[30rem] -translate-x-1/2 -translate-y-1/2 blur-3xl"
  >
  </div>

  <div class="relative mx-auto flex min-h-[90vh] w-full max-w-5xl flex-col justify-center px-6 py-20">
    <!-- terminal status line -->
    <p class="reveal flex items-center gap-2 font-mono text-sm text-muted">
      <span class="dot-pulse inline-block h-2 w-2 rounded-full bg-accent"></span>
      <span class="text-accent">~</span>
      <span>{location}</span>
      <span class="caret" aria-hidden="true"></span>
    </p>

    <h1
      data-hero-name
      class="reveal name-shine mt-6 font-display text-6xl font-bold leading-[0.98] tracking-tight sm:text-7xl md:text-8xl"
      style="--reveal-delay: 80ms"
    >
      {name}
    </h1>

    <p
      class="reveal mt-6 max-w-2xl text-xl leading-snug text-muted md:text-2xl"
      style="--reveal-delay: 160ms"
    >
      <span class="font-medium text-fg">{headline}</span> building {tagline}.
    </p>

    <nav
      class="reveal mt-10 flex flex-wrap items-center gap-3"
      aria-label="Primary links"
      style="--reveal-delay: 240ms"
    >
      <a
        href={resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-bg transition-transform hover:-translate-y-0.5"
      >
        Download CV
        <span class="transition-transform group-hover:translate-y-0.5" aria-hidden="true">↓</span>
      </a>
      {
        primary.map((link) => (
          <a
            href={link.href}
            target={link.kind === 'email' ? undefined : '_blank'}
            rel={link.kind === 'email' ? undefined : 'noopener noreferrer'}
            class="rounded-full border border-border bg-surface/60 px-5 py-2.5 text-sm font-medium text-fg backdrop-blur-sm transition-colors hover:border-accent hover:text-accent"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- at-a-glance figures -->
    <dl
      class="reveal mt-16 grid max-w-2xl grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-4"
      style="--reveal-delay: 320ms"
    >
      {
        stats.map((s) => (
          <div class="bg-surface px-5 py-4">
            <dt class="font-mono text-[11px] uppercase tracking-widest text-faint">{s.label}</dt>
            <dd class="mt-1 font-display text-2xl font-semibold text-fg">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!-- scroll cue -->
  <div
    class="reveal pointer-events-none absolute bottom-6 left-1/2 -translate-x-1/2 font-mono text-[11px] uppercase tracking-widest text-faint"
    style="--reveal-delay: 420ms"
    aria-hidden="true"
  >
    scroll ↓
  </div>
</header>
