---
// Project card: a link when href is present, else a plain article.
// `featured` renders the larger hero variant (spans the full projects row).
import type { Project } from '../types/profile';

interface Props {
  project: Project;
  featured?: boolean;
}
const { project, featured = false } = Astro.props;
const Tag = project.href ? 'a' : 'article';
const linkAttrs = project.href
  ? { href: project.href, target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<Tag
  {...linkAttrs}
  data-spotlight
  class:list={[
    'spotlight lift group flex h-full flex-col rounded-xl border border-border bg-surface hover:border-accent/60',
    featured ? 'p-7 md:p-8' : 'p-6',
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <div>
      {featured && (
        <span class="mb-1.5 block font-mono text-[11px] uppercase tracking-widest text-accent-dim">
          featured
        </span>
      )}
      <h3
        class:list={[
          'font-display font-semibold group-hover:text-accent',
          featured ? 'text-2xl md:text-3xl' : 'text-lg',
        ]}
      >
        {project.name}
      </h3>
    </div>
    {
      project.href && (
        <span
          class="shrink-0 text-muted transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
          aria-hidden="true"
        >
          ↗
        </span>
      )
    }
  </div>

  <time class="mt-0.5 font-mono text-xs text-faint">{project.period}</time>

  <p
    class:list={[
      'mt-3 flex-1 leading-relaxed text-fg/80',
      featured ? 'max-w-2xl text-base' : 'text-sm',
    ]}
  >
    {project.description}
  </p>

  <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tech stack">
    {
      project.stack.map((tech) => (
        <li class="rounded border border-border/70 bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-muted">
          {tech}
        </li>
      ))
    }
  </ul>
</Tag>
