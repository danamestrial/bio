---
interface NavItem {
  id: string;
  label: string;
}
interface Props {
  name: string;
  items: NavItem[];
}
const { name, items } = Astro.props;
---

<header class="sticky top-4 z-40 px-4">
  <nav
    class="mx-auto flex w-fit max-w-full items-center rounded-full border border-border bg-bg/70 py-2 pl-4 pr-2 shadow-lg shadow-black/40 backdrop-blur-md"
    aria-label="Primary"
  >
    <a
      href="#top"
      data-brand
      class="nav-brand flex shrink-0 items-center gap-2 font-display text-sm font-semibold tracking-tight hover:text-accent"
    >
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
      {name}
    </a>
    <ul
      data-nav-list
      class="flex gap-0.5 overflow-x-auto whitespace-nowrap [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        items.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              data-nav={item.id}
              class="rounded-full px-3 py-1.5 font-mono text-xs uppercase tracking-wide text-muted transition-colors hover:text-fg aria-[current=true]:bg-surface-2 aria-[current=true]:text-accent"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  /* Hint that the item list scrolls (mobile): fade the clipped right edge. */
  ul.can-scroll-right {
    mask-image: linear-gradient(to right, black calc(100% - 2.5rem), transparent);
  }

  /* Brand is hidden while the hero name is on screen, then slides in once the
     hero name scrolls out of view (toggled by [data-brand].is-shown via JS).
     Collapsing max-width keeps it out of the flow so the links sit flush left. */
  .nav-brand {
    max-width: 0;
    margin-right: 0;
    opacity: 0;
    transform: translateX(-6px);
    overflow: hidden;
    white-space: nowrap;
    transition:
      max-width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      margin-right 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-brand.is-shown {
    max-width: 14rem;
    margin-right: 0.75rem;
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-brand {
      transform: none;
      transition: opacity 0.2s ease;
    }
  }
</style>

<script>
  // Reveal the navbar name only once the hero name has scrolled out from under
  // the sticky nav — no point showing it twice while the big one is on screen.
  const brand = document.querySelector<HTMLElement>('[data-brand]');
  const heroName = document.querySelector<HTMLElement>('[data-hero-name]');
  if (brand && heroName && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([entry]) => brand.classList.toggle('is-shown', !entry.isIntersecting),
      // Shrink the root's top by the nav's height so the flip happens exactly as
      // the hero name passes behind the nav, not when it hits the viewport top.
      { rootMargin: '-72px 0px 0px 0px', threshold: 0 }
    );
    io.observe(heroName);
  } else {
    // No hero name / no observer support: fall back to always showing it.
    brand?.classList.add('is-shown');
  }
</script>

<script>
  // Scroll-spy: highlight the section currently in view. A plain scroll handler
  // (not IntersectionObserver) so the last/short section still activates when
  // the page bottoms out before that section can reach the trigger band.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((a) =>
    links.set(a.dataset.nav!, a)
  );
  const ids = [...links.keys()];
  const sections = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  // On narrow screens the list scrolls horizontally; fade the right edge while
  // more items are clipped there, and keep the active item scrolled into view.
  const list = document.querySelector<HTMLElement>('[data-nav-list]')!;
  const updateFade = () =>
    list.classList.toggle(
      'can-scroll-right',
      list.scrollLeft + list.clientWidth < list.scrollWidth - 4
    );
  list.addEventListener('scroll', updateFade, { passive: true });
  window.addEventListener('resize', updateFade, { passive: true });
  updateFade();

  let lastId = '';
  const setCurrent = (id: string) => {
    for (const [key, a] of links) a.setAttribute('aria-current', String(key === id));
    if (id !== lastId) {
      lastId = id;
      // block: 'nearest' keeps the page from scrolling vertically; only the
      // overflowing list moves.
      links.get(id)?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
    }
  };

  let ticking = false;
  const spy = () => {
    ticking = false;
    // At (or near) the page bottom, the last section is the active one even if
    // it never scrolls up to the trigger line.
    const atBottom =
      window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
    if (atBottom) {
      setCurrent(ids[ids.length - 1]);
      return;
    }
    // Otherwise: the last section whose top has crossed ~30% down the viewport.
    const line = window.innerHeight * 0.3;
    let current = ids[0];
    for (const el of sections) {
      if (el.getBoundingClientRect().top <= line) current = el.id;
      else break;
    }
    setCurrent(current);
  };

  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(spy);
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  spy();
</script>
